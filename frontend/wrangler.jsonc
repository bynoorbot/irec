{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "aura.bynoor.io",
      "custom_domain": true
    }
  ]
}
